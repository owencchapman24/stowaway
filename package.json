{
  "name": "stowaway",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0 <23 || >=24.3.0 <25"
  },
  "scripts": {
    "postinstall": "node scripts/epub-patch-parser.cjs",
    "precheck": "node scripts/epub-patch-parser.cjs --check",
    "start": "node scripts/expo-internal.mjs --go",
    "android": "node scripts/expo-internal.mjs --android --go",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:epub": "jest --runInBand --testPathPattern=epub",
    "test:epub-security": "jest --runInBand --runTestsByPath tests/epub-security.test.ts tests/epub-budgets.test.ts",
    "test:epub-report": "jest --runInBand --runTestsByPath tests/epub-diagnostic.test.ts tests/epub-native.test.ts",
    "test:epub-remediation": "jest --runInBand --runTestsByPath tests/epub-mutation.test.ts tests/epub-xml-remediation.test.ts tests/epub-host-gate.test.ts tests/epub-screen.test.tsx tests/epub-performance.test.ts tests/epub-reliability.test.ts tests/epub-native.test.ts",
    "epub:host-report": "node scripts/epub-host-report.cjs",
    "epub:xml-benchmark": "node scripts/epub-xml-benchmark.cjs",
    "epub:parser-benchmark": "node scripts/epub-parser-benchmark.cjs",
    "epub:fixtures": "node scripts/epub-host-report.cjs --fixtures",
    "test:lint-boundary": "node --test --test-reporter=spec tests/lint-boundary.test.cjs",
    "check": "npm run typecheck && npm run lint && npm run test:lint-boundary && npm test"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@rgrove/parse-xml": "5.0.0",
    "domhandler": "^6.0.1",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "htmlparser2": "^12.0.0",
    "pako": "3.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "22",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
