{
  "cli": {
    "version": ">= 24.12.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_STOWAWAY_BUILD_AUDIENCE": "internal-personal" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_STOWAWAY_BUILD_AUDIENCE": "internal-personal" }
    },
    "epub-diagnostic": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_STOWAWAY_BUILD_AUDIENCE": "internal-personal",
        "EXPO_PUBLIC_STOWAWAY_EPUB_DIAGNOSTIC": "enabled"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "env": { "EXPO_PUBLIC_STOWAWAY_BUILD_AUDIENCE": "public" }
    }
  },
  "submit": {
    "production": {}
  }
}
