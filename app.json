{
  "expo": {
    "name": "Stowaway",
    "slug": "stowaway",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "stowaway",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.owencchapman.stowaway",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/stowaway-icon-default-1024.png",
        "dark": "./assets/stowaway-icon-dark-1024.png",
        "tinted": "./assets/stowaway-icon-tinted-1024.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F0E6",
          "dark": {
            "backgroundColor": "#171D24"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9d185605-2eeb-49c7-82bd-baf15a7f7345"
      }
    }
  }
}
